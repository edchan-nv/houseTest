        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def RenderProduct "Product" (
        prepend apiSchemas = ["OmniRtxSettingsCommonAdvancedAPI_1", "OmniRtxSettingsPtAdvancedAPI_1", "OmniRtxSettingsRtAdvancedAPI_1"]
    )
    {
        rel camera = </Tour/Camera>
        custom uint omni:rtx:pt:samplesPerPixel = 96
        custom token omni:rtx:rendermode = "PathTracing"
        rel orderedVars = </Tour/LdrColor>
        uniform int2 resolution = (1440, 900)
    }

    def RenderVar "LdrColor"
    {
        uniform string sourceName = "LdrColor"
    }

    def RenderSettings "Settings"
    {
        rel products = </Tour/Product>
    }

    def DomeLight "Sky"
    {
        color3f inputs:color = (0.72, 0.83, 1)
        float inputs:intensity = 1800
    }
}

